PORT=5001

# Google Maps Platform (Routes API) — used for live traffic / commute distance
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Campus coordinates (PSG College of Technology, Peelamedu, Coimbatore)
CAMPUS_LAT=11.0242544
CAMPUS_LNG=77.0028228

# OpenWeatherMap — current weather at the student's home and on campus at check-in
OPENWEATHER_API_KEY=your-openweathermap-api-key

# Google Gemini — speech-to-text and statement analysis for late arrival explanations
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash

# Password given to newly created demo accounts (students log in with their roll number)
DEMO_PASSWORD=veritime123

# Minutes a student has, after a late classroom tap, to record their explanation
STATEMENT_WINDOW_MINUTES=10

# Public address of the website (phone mode); used for the QR code shown after a late tap
PUBLIC_WEB_URL=https://<your-computer-ip>:5173
